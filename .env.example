# ---------------------------------------------------------------------------
# INTEGRA SCIENCE — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# Rien ici n'est requis pour lancer le site en local : un champ vide ne rend rien.
# Ne jamais committer de valeur reelle : .env.local est ignore par Git.
# ---------------------------------------------------------------------------

# URL publique du site (sans slash final). Blocant : tant qu'elle est vide,
# robots.txt interdit tout et les URL canoniques pointent sur localhost.
NEXT_PUBLIC_SITE_URL=

# Envoi des emails (Brevo, 300 messages/jour en gratuit). Blocant pour les formulaires.
BREVO_API_KEY=
CONTACT_DESTINATAIRE=
EXPEDITEUR_EMAIL=

# ---------------------------------------------------------------------------
# BACK-OFFICE (/admin)
# Les personnes se connectent avec leur propre compte (adresse + mot de passe),
# cree par le premier proprietaire depuis /admin/comptes.
#
# ADMIN_PASSWORD : cle d'installation, demandee UNE SEULE FOIS, sur /admin/installer,
# pour creer le premier compte proprietaire. Ce n'est pas un mot de passe de
# connexion. Absente, la page d'installation est ouverte a qui arrive en premier.
# ADMIN_SECRET : cle de signature des cookies de session (32 octets aleatoires).
# A generer une fois puis a ne plus changer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans elle, ADMIN_PASSWORD sert de secret de repli.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SECRET=

# Ecriture du contenu : un commit par enregistrement, puis redeploiement.
# Token GitHub classique (scope `repo`) ou « fine-grained » (Contents: Read and
# write) sur le depot ci-dessous. Sans lui : ecriture limitee au disque local,
# et comptes/contenu non modifiables en production.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=nicearts44/integra_science
ADMIN_GITHUB_BRANCH=main

# Base de donnees (messages des formulaires, abonnes de la newsletter).
# Neon (offre gratuite) convient : copier la chaine « connection string »
# fournie par Neon, avec `?sslmode=require` a la fin.
# Tant qu'elle est vide, l'hebergement perd ces donnees a chaque deploiement.
DATABASE_URL=

# CMS headless Sanity — editeur sans code sur /studio/
#
# Studio (navigateur) : ces deux variables DOIVENT etre prefixees NEXT_PUBLIC_,
# sinon elles ne sont pas transmises au navigateur et le Studio affiche
# « Invalid project id ». L'identifiant de projet et le jeu de donnees sont
# publics : ce ne sont pas des secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Alias acceptes cote serveur (CLI Sanity, scripts) :
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Site (lecture serveur) — le token n'est jamais expose au navigateur :
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=
